// Cloudflare Workers config: serves the Vite build as static files, plus the Worker in worker/
// for the admin panel's API, its database (D1) and its photo storage (R2)
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "scandinavia-guest-house",
    "compatibility_date": "2026-10-01",
    "main": "worker/index.js",
    "assets": {
        "directory": "./build",
        "binding": "ASSETS",
        // Unknown paths such as /bungalow get index.html, so React Router can handle them
        "not_found_handling": "single-page-application",
        // Only these reach the Worker; everything else is served as files, without running it
        "run_worker_first": ["/api/*", "/media/*"]
    },
    // Texts and photo links edited in the admin (one row). Create it with
    // `npx wrangler d1 create scandinavia-guest-house-content` and put the id it prints here
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "scandinavia-guest-house-content",
            "database_id": "REPLACE_WITH_DATABASE_ID",
            "migrations_dir": "migrations"
        }
    ],
    // Photos and videos uploaded in the admin. Create it with
    // `npx wrangler r2 bucket create scandinavia-guest-house-media`
    "r2_buckets": [
        {
            "binding": "MEDIA",
            "bucket_name": "scandinavia-guest-house-media"
        }
    ],
    // Cloudflare Access, which guards /admin and /api/admin: the team domain
    // (<team>.cloudflareaccess.com) and the application's "Application Audience (AUD) Tag",
    // both from the Zero Trust dashboard. The admin API refuses every request while they are empty
    "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
    }
}
