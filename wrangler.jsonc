// Cloudflare Workers config: serves the Vite build as static files.
// The admin panel will later add its server code ("main") and storage bindings here.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "scandinavia-guest-house",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./build",
        // Unknown paths such as /bungalow get index.html, so React Router can handle them
        "not_found_handling": "single-page-application"
    }
}
